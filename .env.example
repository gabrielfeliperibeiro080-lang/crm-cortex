# Copie para .env.local e preencha. NUNCA commite o .env.local.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Supabase > Project Settings > API > Project URL (sem /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API > anon / publishable key (pública; o RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > service_role / secret key
# SEGREDO TOTAL: ignora o RLS. Só no servidor (criar parceiros e redefinir senhas).
# Nunca use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=
